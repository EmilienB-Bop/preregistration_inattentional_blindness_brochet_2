# 2. Test de permutation non paramétrique du Multiverse (Section 9.4)
# NB : Fixer N_PERMUTATIONS = 5000 pour l'analyse finale du manuscrit BRM
N_PERMUTATIONS <- 500 

run_multiverse_metrics <- function(df_input) {
  # Évaluation vectorisée rapide des 320 univers pour les permutations
  pk_opts  <- list(exclude_prior = !df_input$excl_prior_know, retain_all = rep(TRUE, nrow(df_input)))
  acc_cuts <- c(0, 20, 30, 40, 50, 60, 70, 80)
  fa_opts  <- list(exclude_deniers = !df_input$excl_full_attn, retain_all = rep(TRUE, nrow(df_input)))
  det_cols <- list(
    as.integer(df_input$det_t3 == 1L),
    as.integer(df_input$det_t3 == 1L & df_input$shape_ok_t3),
    as.integer(df_input$det_t3 == 1L & df_input$color_ok_t3),
    as.integer(df_input$det_t3 == 1L & df_input$size_ok_t3),
    as.integer(df_input$det_t3 == 1L & df_input$shape_ok_t3 & df_input$color_ok_t3),
    as.integer(df_input$det_t3 == 1L & df_input$shape_ok_t3 & df_input$size_ok_t3),
    as.integer(df_input$det_t3 == 1L & df_input$color_ok_t3 & df_input$size_ok_t3),
    as.integer(df_input$det_t3 == 1L & df_input$all_ok_t3),
    as.integer(df_input$det_t4 == 1L & df_input$all_ok_t4),
    as.integer(df_input$det_t5 == 1L & df_input$all_ok_t5)
  )
  
  is_match <- as.integer(df_input$congruence == "Match")
  ors  <- numeric(320)
  sigs <- logical(320)
  u <- 1L
  
  for (pk in pk_opts) {
    for (ac in acc_cuts) {
      acc_ok <- if (ac == 0) rep(TRUE, nrow(df_input)) else (!is.na(df_input$mean_acc_precrit) & !is.na(df_input$acc_trial3) & df_input$mean_acc_precrit >= ac & df_input$acc_trial3 >= ac)
      for (fa in fa_opts) {
        keep <- pk & acc_ok & fa
        x <- is_match[keep]
        for (dc in det_cols) {
          y <- dc[keep]
          fit <- glm.fit(x = cbind(1, x), y = y, family = binomial())
          b1  <- fit$coefficients[2]
          se1 <- sqrt(diag(chol2inv(fit$qr$qr[1:2, 1:2])))[2]
          z1  <- b1 / se1
          ors[u]  <- exp(b1)
          sigs[u] <- (b1 > 0) && (2 * pnorm(-abs(z1)) < 0.05)
          u <- u + 1L
        }
      }
    }
  }
  c(median_or = median(ors, na.rm = TRUE), prop_sig = mean(sigs, na.rm = TRUE))
}

obs_metrics <- run_multiverse_metrics(mv_base)

perm_matrix <- replicate(N_PERMUTATIONS, {
  df_perm <- mv_base
  df_perm$congruence <- sample(df_perm$congruence)
  run_multiverse_metrics(df_perm)
})

p_val_median_or <- (sum(perm_matrix["median_or", ] >= obs_metrics["median_or"]) + 1) / (N_PERMUTATIONS + 1)
p_val_prop_sig  <- (sum(perm_matrix["prop_sig", ]  >= obs_metrics["prop_sig"])  + 1) / (N_PERMUTATIONS + 1)

cat(sprintf("\n--- MULTIVERSE PERMUTATION TEST (%d RESAMPLES) ---\n", N_PERMUTATIONS))
cat(sprintf("Observed Median OR = %.2f (Permutation p = %.4f)\n", obs_metrics["median_or"], p_val_median_or))
cat(sprintf("Observed Share Significant = %.1f%% (Permutation p = %.4f)\n", 100 * obs_metrics["prop_sig"], p_val_prop_sig))
