eval_subthreshold <- function(resp_vec, correct_vec, label) {
  n_total   <- length(resp_vec)
  n_escape  <- sum(resp_vec == "none", na.rm = TRUE)
  n_forced  <- n_total - n_escape
  n_correct <- sum(correct_vec[resp_vec != "none"], na.rm = TRUE)
  binom_res <- binom.test(n_correct, n_forced, p = 0.50, alternative = "two.sided")
  
  tibble(
    Feature          = label,
    N_NonNoticers    = n_total,
    Escape_None_Pct  = round(100 * n_escape / n_total, 1),
    N_PhysicalChoice = n_forced,
    Cond_Accuracy    = round(100 * n_correct / n_forced, 1),
    CI_95_Low        = round(binom_res$conf.int[1] * 100, 1),
    CI_95_High       = round(binom_res$conf.int[2] * 100, 1),
    p_value          = binom_res$p.value
  )
}

